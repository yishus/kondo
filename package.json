{
  "name": "kondo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "db:schema:sql": "drizzle-kit export",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "dev": "react-router dev",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "deploy": "bun run build && bun run db:migrate && wrangler deploy",
    "preview": "bun run build && vite preview",
    "cf-typegen": "wrangler types",
    "postinstall": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply DB --local"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.14",
    "@dnd-kit/core": "^6.3.1",
    "better-auth": "^1.7.14",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.11.2",
    "isbot": "^5.2.2",
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.1",
    "remark-gfm": "^4.0.1",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@react-router/dev": "^8.5.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "wrangler": "^4.156.0"
  },
  "description": "A self-hosted trip planner for type A travelers.",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.0",
    "bun": ">=1.3.4"
  },
  "packageManager": "bun@1.3.4"
}
